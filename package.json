{
	"name": "vite-plugin-env-import",
	"description": "Import modules isomorphically in the client, server, dev, or prod",
	"version": "1.3.0",
	"author": "lunate",
	"license": "MIT",
	"type": "module",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"index.d.ts"
	],
	"homepage": "https://github.com/otomad/vite-plugin-env-import",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/otomad/vite-plugin-env-import.git"
	},
	"bugs": {
		"url": "https://github.com/otomad/vite-plugin-env-import/issues"
	},
	"keywords": [
		"vite",
		"plugin",
		"isomorphic",
		"import"
	],
	"scripts": {
		"why-ts-plugin": "tsx scripts/createFacadeTsPlugin.ts",
		"build:tsc": "pnpm run clean && tsc --build ./tsconfig.cjs.json ./tsconfig.esm.json && pnpm run fix:prettier-dist",
		"clean": "rimraf ./dist",
		"fix:prettier-dist": "prettier dist/**/*.js --write --ignore-path=.prettierignore"
	},
	"packageManager": "pnpm@9.15.4",
	"dependencies": {
		"es-module-lexer": "^1.6.0",
		"magic-string": "^0.30.17"
	},
	"peerDependencies": {
		"vite": ">=2.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.10",
		"prettier": "^3.5.3",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"vite": "^6.0.11"
	}
}
