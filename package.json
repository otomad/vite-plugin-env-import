{
	"name": "vite-plugin-env-import",
	"description": "Import modules isomorphically in the client, server, dev, or prod",
	"version": "1.3.0",
	"author": "lunate",
	"license": "MIT",
	"type": "commonjs",
	"types": "./index.d.ts",
	"main": "./src/index.cjs",
	"exports": {
		".": {
			"import": {
				"types": "./index.d.ts",
				"default": "./index.mjs"
			},
			"require": {
				"types": "./index.d.ts",
				"default": "./index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"index.d.ts",
		"index.js",
		"index.cjs",
		"index.mjs"
	],
	"homepage": "https://github.com/otomad/vite-plugin-env-import",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/otomad/vite-plugin-env-import.git"
	},
	"bugs": {
		"url": "https://github.com/otomad/vite-plugin-env-import/issues"
	},
	"keywords": [
		"vite",
		"plugin",
		"isomorphic",
		"import"
	],
	"scripts": {
		"why-ts-plugin": "tsx scripts/createFacadeTsPlugin.ts",
		"build:tsc": "pnpm run clean && tsc --build ./tsconfig.cjs.json && pnpm run fix:prettier-dist && pnpm run clean-tsbuildinfo",
		"clean": "rimraf ./dist ./index.js ./index.cjs ./index.mjs",
		"fix:prettier-dist": "prettier *.js *.cjs *.mjs --write --ignore-path=.prettierignore",
		"clean-tsbuildinfo": "rimraf -g *.tsbuildinfo"
	},
	"packageManager": "pnpm@10.14.0",
	"dependencies": {
		"es-module-lexer": "^1.7.0",
		"magic-string": "^0.30.17"
	},
	"peerDependencies": {
		"vite": ">=2.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.1.0",
		"prettier": "^3.5.3",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.3",
		"typescript": "^5.9.2",
		"vite": "^7.0.6"
	}
}
